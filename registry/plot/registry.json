{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "plot",
      "type": "registry:ui",
      "title": "Plot",
      "description": "Function sampling, parameter controls, and heatmaps for shadcn charts and Recharts.",
      "files": [
        {
          "path": "lib/data.ts",
          "type": "registry:lib",
          "target": "@lib/plot/data.ts"
        },
        {
          "path": "ui/plot-controls.tsx",
          "type": "registry:ui",
          "target": "@ui/plot/plot-controls.tsx"
        },
        {
          "path": "ui/plot-heatmap.tsx",
          "type": "registry:ui",
          "target": "@ui/plot/plot-heatmap.tsx"
        },
        {
          "path": "ui/plot-line.tsx",
          "type": "registry:ui",
          "target": "@ui/plot/plot-line.tsx"
        },
        {
          "path": "ui/plot.tsx",
          "type": "registry:ui",
          "target": "@ui/plot/plot.tsx"
        }
      ],
      "dependencies": ["recharts@3.8.0", "cn"],
      "registryDependencies": ["chart", "slider"]
    },
    {
      "name": "function-plot",
      "type": "registry:ui",
      "title": "Function Plot",
      "description": "Interactive function curves with generated shadcn sliders and Recharts rendering.",
      "registryDependencies": ["EdwardAstill/edcn/plot", "card"],
      "files": [
        {
          "path": "components/function-plot.tsx",
          "type": "registry:component",
          "target": "@components/plot/function-plot.tsx"
        },
        {
          "path": "ui/function-plot.tsx",
          "type": "registry:ui",
          "target": "@ui/plot/function-plot.tsx"
        }
      ]
    }
  ]
}
