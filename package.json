{
  "name": "edcn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "css": "bunx @tailwindcss/cli -i preview/styles/globals.css -o preview/styles/build.css --minify",
    "css:watch": "bunx @tailwindcss/cli -i preview/styles/globals.css -o preview/styles/build.css --watch=always",
    "preview:gen": "bun scripts/generate-preview-index.ts",
    "lint": "eslint .",
    "registry:build": "bun run registry:validate && shadcn build && bun run preview:gen",
    "typecheck": "bun run preview:gen && tsc --noEmit",
    "test": "bun test ./tests",
    "registry:validate": "shadcn registry validate ./registry.json",
    "check": "bun run registry:validate && bun run typecheck && bun run lint && bun run test",
    "calculator:gen": "bun scripts/render-calculator-help.ts && bun scripts/render-calculator-solver-source.ts && bun scripts/render-calculator-solver-worker.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@shadcn/react": "^0.3.0",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "lucide-react": "^0.487.0",
    "pyodide": "^314.0.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^20.19.43",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "happy-dom": "^15.11.7"
  },
  "overrides": {
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2"
  }
}
